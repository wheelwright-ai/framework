"""
Teach Command - Distribute updated template files to spokes using upgrade adoption plans.

Process:
1. Scan framework templates (spoke and hub)
2. Compute file hashes and version context
3. Generate signed upgrade-adoption-plan.json
4. Distribute plan to spoke/hub for verification and adoption
"""

import json
import shutil
from pathlib import Path
from datetime import datetime
from typing import Dict, List, Any, Optional

from ..reference_manager import TeachingManager
from ..upgrade_adoption import (
    UpgradeAdoptionPlanBuilder,
    sign_upgrade_plan,
    save_upgrade_plan,
    verify_upgrade_ingestion_complete,
    ensure_upgrade_adoption_tracked
)
from ..upgrade_adoption_consumer import UpgradeAdoptionConsumer
from ..utils.input import print_info, print_success, print_error, print_warning
from ..core import FRAMEWORK_VERSION
from ..output_formatter import TeachOutputFormatter


def cleanup_deprecated_templates(
    spoke_path: Path,
    current_plan: Dict[str, Any],
    hub_fingerprint: Optional[str]
) -> int:
    """
    Remove deprecated and orphaned teaching files.

    Removes files that:
    1. **Unsigned (recommended):** All teaching files (both .teaching and bare) not in current plan (orphaned)
    2. **Hub-signed:** Files in previous plan but not in current plan (deprecated)

    Preserves files that:
    - Are in current plan (being adopted or reviewed)
    - Have mismatched fingerprint (custom teachings from other hub)
    - Are metadata files (manifest.json, disposition-log.jsonl)

    Args:
        spoke_path: Path to spoke
        current_plan: Current upgrade adoption plan
        hub_fingerprint: Current hub fingerprint (if any)

    Returns:
        Number of deprecated/orphaned files removed
    """
    ingest_dir = spoke_path / 'WAI-Spoke' / 'seed' / 'ingest'
    if not ingest_dir.exists():
        return 0

    # Build set of current plan files (these should NOT be removed)
    safe_files = set()
    for file_entry in current_plan.get('files', []):
        name = file_entry.get('name', '')
        safe_files.add(name)
        safe_files.add(f"{name}.teaching")

    for file_entry in current_plan.get('hub_files', []):
        name = file_entry.get('name', '')
        safe_files.add(name)
        safe_files.add(f"{name}.teaching")

    # Metadata files that should never be removed
    metadata_files = {'manifest.json', 'disposition-log.jsonl', 'upgrade-adoption-plan.json'}

    # Get all files in ingest (both .teaching and bare)
    all_files = set()
    for item in ingest_dir.glob('*'):
        if item.is_file() and item.name not in metadata_files:
            all_files.add(item.name)

    # Determine what to remove based on fingerprint
    if not hub_fingerprint:
        # UNSIGNED: Remove ALL orphaned files not in current plan (safe for dev-managed upgrades)
        to_remove = all_files - safe_files
        cleanup_reason = "orphaned (unsigned upgrade)"
    else:
        # HUB-SIGNED: Two-phase removal
        # Phase 1: Remove files explicitly deprecated (in previous plan but not current)
        # Phase 2: Remove other orphans IF verification is complete and files aren't pending adoption
        
        to_remove = set()
        cleanup_reason = "deprecated/orphaned (hub-signed update)"
        
        prev_plan_path = spoke_path / 'upgrade-adoption-plan.json'
        if prev_plan_path.exists():
            try:
                prev_plan = json.loads(prev_plan_path.read_text(encoding='utf-8'))
                prev_fingerprint = prev_plan.get('verification', {}).get('hub_fingerprint')
                
                # Phase 1: If from same hub, remove files that were explicitly deprecated
                if prev_fingerprint == hub_fingerprint:
                    prev_files = set()
                    for f in prev_plan.get('files', []):
                        name = f.get('name', '')
                        prev_files.add(f"{name}.teaching")
                        prev_files.add(name)
                    for f in prev_plan.get('hub_files', []):
                        name = f.get('name', '')
                        prev_files.add(f"{name}.teaching")
                        prev_files.add(name)
                    
                    to_remove.update(prev_files - safe_files)
            except Exception:
                pass  # Can't load previous plan, skip phase 1
        
        # Phase 2: After explicit deprecations, also remove other orphans
        # (manually placed files, legacy distributions) ONLY if adoption is complete
        try:
            verify_result = verify_upgrade_ingestion_complete(
                spoke_path / 'upgrade-adoption-plan.json',
                spoke_path / 'WAI-Spoke' / 'seed' / 'ingest'
            )
            # Only if no pending files AND no orphans in adoption queue
            if verify_result.get('is_complete'):
                # Safe to remove other orphans too
                other_orphans = all_files - safe_files - to_remove
                if other_orphans:
                    to_remove.update(other_orphans)
        except Exception:
            pass  # Verification failed, don't remove other orphans

    # Remove files
    removed_count = 0
    for file_name in sorted(to_remove):
        file_path = ingest_dir / file_name
        if file_path.exists() and file_path.is_file():
            try:
                file_path.unlink()
                print_success(f"    [CLEANUP] Removed {cleanup_reason}: {file_name}")
                removed_count += 1
            except Exception as e:
                print_warning(f"    Could not remove {file_name}: {e}")

    return removed_count


def teach_command(spoke_path: Path, hub_path: Optional[Path], framework_path: Path) -> bool:
    """
    Teach a spoke (and optionally hub) with updated templates from framework using upgrade adoption plans.
    
    Args:
        spoke_path: Path to project to teach
        hub_path: Path to hub (optional, for knowledge distribution and hub self-update)
        framework_path: Path to framework (source of templates)
    
    Returns:
        True if teaching completed
    """
    wai_spoke_templates_dir = framework_path / 'templates' / 'WAI-Spoke'
    wai_hub_templates_dir = framework_path / 'templates' / 'HUB'
    
    if not wai_spoke_templates_dir.exists():
        print_error(f"  Framework templates not found at {wai_spoke_templates_dir}")
        return False
    
    # Determine if hub is being taught (has WAI-Spoke/ structure)
    is_hub_target = hub_path and (hub_path / 'WAI-Spoke').exists() if hub_path else False
    
    # VERIFY PREVIOUS UPGRADE COMPLETENESS
    # Check for leftover .teaching files from previous upgrades
    print_info("  Verifying previous upgrade ingestion...")
    spoke_ingest_dir = spoke_path / 'WAI-Spoke' / 'seed' / 'ingest'
    spoke_plan_path = spoke_path / 'upgrade-adoption-plan.json'
    
    if spoke_plan_path.exists() and spoke_ingest_dir.exists():
        verify_result = verify_upgrade_ingestion_complete(spoke_plan_path, spoke_ingest_dir)
        if not verify_result["is_complete"]:
            # There are orphaned files - report them
            for issue in verify_result["issues"]:
                print_warning(f"    ⚠ {issue}")
            if verify_result["orphaned"]:
                print_info(f"    Orphaned files: {', '.join(verify_result['orphaned'][:3])}")
                # Don't fail - just warn, let agent review manually
        else:
            print_success(f"    ✓ Previous upgrade complete")
    
    print_info("  Generating Upgrade Adoption Plan...")
    if is_hub_target:
        print_info(f"  Teaching both spoke ({spoke_path.name}) and hub ({hub_path.name})")
    
    # Create builder for upgrade adoption plan
    builder = UpgradeAdoptionPlanBuilder(
        framework_version=FRAMEWORK_VERSION,
        spoke_structure_version="3.0",
        source="framework"
    )
    
    # Core spoke template files
    spoke_files = [
        {
            'name': 'WAI-Guide.md',
            'path': 'WAI-Spoke/WAI-Guide.md',
            'changed_from': '2.1.0',
            'why_changed': 'Enhanced session start protocol, added teaching reconciliation section',
            'safe_to_auto_adopt': True,
            'requires_review': False,
            'mentions': ['session-start', 'teaching', 'reconciliation'],
            'applies_to': ['spoke', 'hub'],
        },
        {
            'name': 'WAI-State.json',
            'path': 'WAI-Spoke/WAI-State.json',
            'changed_from': '2.0.1',
            'why_changed': 'Structure version 3.0, added teaching-adoption-plan schema',
            'safe_to_auto_adopt': False,
            'requires_review': True,
            'mentions': ['structure', 'version', 'state-management'],
            'applies_to': ['spoke', 'hub'],
            'merge_strategy': 'merge_sections',
            'sections_to_preserve': ['_session_state', '_project_foundation', 'decisions', 'analytics'],
            'sections_to_update': ['wheelwright.structure_version', 'wheelwright.version', '_file_meta'],
        },
        {
            'name': 'WAI-State.md',
            'path': 'WAI-Spoke/WAI-State.md',
            'changed_from': '2.0.0',
            'why_changed': 'Updated strategic context for version 3.0',
            'safe_to_auto_adopt': True,
            'requires_review': False,
            'mentions': ['strategy', 'context'],
            'applies_to': ['spoke'],
        },
    ]
    
    # Add spoke files
    spoke_count = 0
    for file_config in spoke_files:
        src_path = wai_spoke_templates_dir / file_config['name']
        if src_path.exists():
            builder.add_file(
                name=file_config['name'],
                path=file_config['path'],
                source_path=str(src_path),
                version=FRAMEWORK_VERSION,
                changed_from=file_config['changed_from'],
                why_changed=file_config['why_changed'],
                safe_to_auto_adopt=file_config['safe_to_auto_adopt'],
                requires_review=file_config['requires_review'],
                merge_strategy=file_config.get('merge_strategy'),
                sections_to_preserve=file_config.get('sections_to_preserve'),
                sections_to_update=file_config.get('sections_to_update'),
                mentions=file_config.get('mentions', []),
                applies_to=file_config.get('applies_to', ['spoke'])
            )
            spoke_count += 1
            print_success(f"    [OK] {file_config['name']}")
    
    # Add hub files if teaching hub
    hub_count = 0
    if is_hub_target and wai_hub_templates_dir.exists():
        # Hub gets its own WAI-Spoke templates
        hub_spoke_templates = wai_hub_templates_dir / 'WAI-Spoke'
        if hub_spoke_templates.exists():
            hub_spoke_files = [
                {
                    'name': 'WAI-State.json',
                    'path': 'WAI-Spoke/WAI-State.json',
                    'changed_from': '3.0.0',
                    'why_changed': 'Hub-specific state with _hub_profile section',
                },
                {
                    'name': 'WAI-State.md',
                    'path': 'WAI-Spoke/WAI-State.md',
                    'changed_from': '3.0.0',
                    'why_changed': 'Hub identity and operations tracking',
                },
                {
                    'name': 'WAI-Guide.md',
                    'path': 'WAI-Spoke/WAI-Guide.md',
                    'changed_from': '3.0.0',
                    'why_changed': 'Hub-specific AI assistant instructions',
                },
            ]
            
            for file_config in hub_spoke_files:
                src_path = hub_spoke_templates / file_config['name']
                if src_path.exists():
                    builder.add_hub_file(
                        name=file_config['name'],
                        path=file_config['path'],
                        source_path=str(src_path),
                        version=FRAMEWORK_VERSION,
                        changed_from=file_config['changed_from'],
                        why_changed=file_config['why_changed'],
                        safe_to_auto_adopt=True
                    )
                    hub_count += 1
        
        # Hub-specific files at root
        hub_files = [
            {
                'name': 'hub-registry.json',
                'path': 'hub-registry.json',
                'changed_from': '2.0.0',
                'why_changed': 'Updated registry tracking wheels and teaching history',
            },
            {
                'name': 'hub-learning-index.md',
                'path': 'hub-learning-index.md',
                'changed_from': '2.0.0',
                'why_changed': 'Knowledge base index for learning aggregation',
            },
            {
                'name': 'hub-security-policy.json',
                'path': 'hub-security-policy.json',
                'changed_from': '2.0.0',
                'why_changed': 'Security settings for hub-spoke communication',
            },
            {
                'name': 'AGENTS.md',
                'path': 'AGENTS.md',
                'changed_from': '2.0.0',
                'why_changed': 'Hub-specific AI assistant instructions (legacy)',
            },
        ]
        
        for file_config in hub_files:
            src_path = wai_hub_templates_dir / file_config['name']
            if src_path.exists():
                builder.add_hub_file(
                    name=file_config['name'],
                    path=file_config['path'],
                    source_path=str(src_path),
                    version=FRAMEWORK_VERSION,
                    changed_from=file_config['changed_from'],
                    why_changed=file_config['why_changed'],
                    safe_to_auto_adopt=True
                )
                hub_count += 1
    
    # Build the plan
    plan = builder.build()
    
    # Ensure plan has tracking metadata for verification
    ensure_upgrade_adoption_tracked(plan, spoke_ingest_dir)
    
    # Sign with hub fingerprint if hub exists
    hub_fingerprint = None
    if hub_path and (hub_path / 'hub-profile.json').exists():
        try:
            profile = json.loads((hub_path / 'hub-profile.json').read_text())
            hub_key = profile.get('hub_config', {}).get('fingerprint', 'wheelwright-default-key')
            plan = sign_upgrade_plan(plan, hub_key)
            hub_fingerprint = plan['verification']['hub_fingerprint']
            print_success(f"    [OK] Signed with hub fingerprint")
        except Exception as e:
            print_warning(f"    Could not sign with hub key: {e}")

    # Clean up deprecated/orphaned template files from previous teach
    print_info("\n  File Hygiene Check...")
    deprecated_count = cleanup_deprecated_templates(spoke_path, plan, hub_fingerprint)
    if deprecated_count > 0:
        print_success(f"    ✓ Cleaned {deprecated_count} orphaned file(s)")
    else:
        # Only show message if there was something to check (previous plan exists)
        prev_plan_path = spoke_path / 'upgrade-adoption-plan.json'
        if prev_plan_path.exists():
            print_success(f"    ✓ No cleanup needed")

    # Distribute actual template files to spoke
    teach_manager = TeachingManager(spoke_path)
    files_distributed = 0

    # Distribute Framework Upgrade Lug (Lugs v2)
    try:
        from ..lugs import Lug

        upgrade_lug_data = {
            'id': 'lug-framework-upgrade-v2',
            'title': 'Framework Upgrade: Lugs v2 Specification',
            'type': 'epic',
            'status': 'open',
            'created_at': datetime.now().isoformat(),
            'priority': 'high',
            'impact': 'large',
            'value': 10,
            'summary': "The Lugs system has been upgraded to v2 to support Conflict Immunity (file sharding) and Hierarchical IDs. All objects must adopt the new specification. Existing 'lugs.jsonl' should be migrated to 'lugs/' directory shards.",
            'policy_tags': ['framework_upgrade'],
            'origin': 'framework:teach'
        }

        dst = teach_manager.ingest_dir / 'lug-framework-upgrade-v2.jsonl'
        # Write minified
        with open(dst, 'w', encoding='utf-8') as f:
            f.write(json.dumps(Lug(upgrade_lug_data).to_minified()) + '\n')

    except Exception as e:
        print_warning(f"    Failed to distribute framework upgrade lug: {e}")
    
    # Distribute spoke files (silently - summary shown below)
    for file_config in spoke_files:
        src_path = wai_spoke_templates_dir / file_config['name']
        if src_path.exists():
            try:
                dst = teach_manager.ingest_dir / f"{file_config['name']}.teaching"
                content = src_path.read_text(encoding='utf-8')
                dst.write_text(content, encoding='utf-8', errors='replace')
                files_distributed += 1
            except Exception as e:
                print_warning(f"    Failed to distribute {file_config['name']}: {e}")

    # Distribute hub files only to hub targets (not regular spokes) - silently
    if is_hub_target and 'hub_files' in locals():
        for file_config in hub_files:
            src_path = wai_hub_templates_dir / file_config['name']
            if src_path.exists():
                try:
                    # Hub files distributed WITHOUT .teaching extension for immediate adoption
                    dst = teach_manager.ingest_dir / file_config['name']
                    content = src_path.read_text(encoding='utf-8')
                    dst.write_text(content, encoding='utf-8', errors='replace')
                    files_distributed += 1
                except Exception as e:
                    print_warning(f"    Failed to distribute {file_config['name']}: {e}")
    
    # Distribute any waiting lugs from hub/outbound/[spoke-id]/
    lugs_distributed = 0
    if hub_path:
        try:
            # Get spoke_id from WAI-State.json if available
            spoke_state_path = spoke_path / 'WAI-Spoke' / 'WAI-State.json'
            spoke_id = spoke_path.name  # fallback
            if spoke_state_path.exists():
                try:
                    state = json.loads(spoke_state_path.read_text(encoding='utf-8'))
                    spoke_id = state.get('_spoke_id', spoke_path.name)
                except Exception:
                    pass
            
            outbound_spoke_dir = hub_path / 'WAI-Hub' / 'outbound' / spoke_id
            if outbound_spoke_dir.exists() and outbound_spoke_dir.is_dir():
                ingest_dir = teach_manager.ingest_dir
                lug_files = list(outbound_spoke_dir.glob('*.jsonl'))
                
                if lug_files:
                    print_info("\n  Distributing Lugs from Hub...")
                    for lug_file in lug_files:
                        try:
                            dst = ingest_dir / lug_file.name
                            shutil.copy2(lug_file, dst)
                            print_success(f"    [OK] {lug_file.name} (lug) → /seed/ingest/")
                            lugs_distributed += 1
                            # Remove from outbound after successful distribution
                            lug_file.unlink()
                        except Exception as e:
                            print_warning(f"    Failed to distribute lug {lug_file.name}: {e}")
        except Exception as e:
            print_warning(f"  Warning: Could not process hub lugs: {e}")
    
    # Save upgrade adoption plan to spoke
    try:
        plan_path = spoke_path / 'upgrade-adoption-plan.json'
        if save_upgrade_plan(plan, plan_path):
            # Get adoption readiness info for summary
            auto_adopt = [f['name'] for f in plan.get('files', []) if f.get('safe_to_auto_adopt')]
            needs_review = [f['name'] for f in plan.get('files', []) if not f.get('safe_to_auto_adopt')]
            
            # Format concise summary with actionable data
            security = "hub-signed" if hub_fingerprint else "unsigned"
            summary = TeachOutputFormatter.format_teach_summary(
                spoke_name=spoke_path.name,
                files_distributed=files_distributed,
                lugs_distributed=lugs_distributed,
                adoption_ready=auto_adopt,
                requires_review=needs_review,
                security=security,
                version=FRAMEWORK_VERSION
            )
            print_success(f"\n{summary}")
            
            # POST-TEACH VERIFICATION: Ensure all teaching files are tracked
            # This prevents orphaned .teaching files from accumulating
            ingest_verification = verify_upgrade_ingestion_complete(plan_path, spoke_ingest_dir)
            if not ingest_verification["is_complete"]:
                # This is OK on first teach (no prior ingestion), but alert if there are real issues
                if ingest_verification["pending"]:
                    print_info(f"    → {len(ingest_verification['pending'])} file(s) awaiting adoption (manual or auto on closeout)")
                if ingest_verification["orphaned"]:
                    print_warning(f"    ⚠ {len(ingest_verification['orphaned'])} orphaned file(s) - manual review needed")
            
            # ENABLE ADOPTION: Create manifest so files can be consumed
            # The manifest tells the adoption system which files to process
            print_info("\n  Enabling file adoption...")
            consumer = UpgradeAdoptionConsumer(spoke_path)
            teach_manifest = {
                "version": "1.0",
                "taught_at": datetime.utcnow().isoformat() + "Z",
                "hub_fingerprint": hub_fingerprint or "unsigned",
                "upgrade_plan_version": plan.get("metadata", {}).get("version", FRAMEWORK_VERSION),
                "files_distributed": files_distributed + lugs_distributed,
                "status": "pending_adoption"
            }
            manifest_path = spoke_ingest_dir / "manifest.json"
            manifest_path.write_text(json.dumps(teach_manifest, indent=2) + '\n', encoding='utf-8')
            print_success(f"    ✓ Manifest created - files ready for adoption")
            
        else:
            print_error(f"  Failed to save upgrade plan to spoke")
            return False
    except Exception as e:
        print_error(f"  Failed to generate upgrade plan for spoke: {e}")
        return False
    
    # If hub is a target, also save upgrade plan there
    if is_hub_target:
        try:
            hub_seed_dir = hub_path / 'WAI-Spoke' / 'seed' / 'ingest'
            hub_seed_dir.mkdir(parents=True, exist_ok=True)
            hub_plan_path = hub_seed_dir / 'upgrade-adoption-plan.json'
            
            if save_upgrade_plan(plan, hub_plan_path):
                # Concise hub update message - details not needed
                pass  # Hub processing happens silently
                
                # Also distribute hub template files to hub's seed/ingest
                if wai_hub_templates_dir.exists():
                    hub_templates_distributed = 0
                    hub_spoke_templates = wai_hub_templates_dir / 'WAI-Spoke'
                    
                    # Copy hub WAI-Spoke templates
                    if hub_spoke_templates.exists():
                        for item in hub_spoke_templates.glob('*.md'):
                            try:
                                dst = hub_seed_dir / item.name
                                shutil.copy2(item, dst)
                                hub_templates_distributed += 1
                            except Exception:
                                pass
                        for item in hub_spoke_templates.glob('*.json'):
                            try:
                                dst = hub_seed_dir / item.name
                                shutil.copy2(item, dst)
                                hub_templates_distributed += 1
                            except Exception:
                                pass
                    
                    # Copy hub root templates
                    for name in ['hub-registry.json', 'hub-security-policy.json', 'hub-learning-index.md']:
                        src = wai_hub_templates_dir / name
                        if src.exists():
                            try:
                                dst = hub_seed_dir / name
                                shutil.copy2(src, dst)
                                hub_templates_distributed += 1
                            except Exception:
                                pass
                    
                    # Hub templates distributed silently
            else:
                print_warning(f"  Could not save upgrade plan to hub")
        except Exception as e:
            print_warning(f"  Could not distribute to hub: {e}")
    
    return True

