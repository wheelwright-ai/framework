  "version_policy": {
    "_description": "How module versions are managed",
    "major_bump": "Breaking changes that require user action or migration",
    "minor_bump": "New features, non-breaking enhancements, integrated hub learnings",
    "patch_bump": "Bug fixes, documentation, minor tweaks (not tracked separately)",
    "sub_version": "Local changes pending hub submission (e.g., 2.0-3 = 3 uncommitted improvements)"
  },

  "sub_version_lifecycle": {
    "_description": "Local change tracking workflow",
    "increment": "When lug implements change to module, append -N (e.g., 2.0 → 2.0-1)",
    "accumulate": "Each change increments N (2.0-1 → 2.0-2 → 2.0-3)",
    "submit": "During closeout, lugs flagged for hub submission",
    "reset": "After teach/reconciliation, hub bumps version and clears suffix (2.0-3 → 2.1)"
  }
