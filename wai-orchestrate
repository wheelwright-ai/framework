#!/usr/bin/env python3
# -*- coding: utf-8 -*-
"""
WAI Orchestrator - Fully automated spoke upgrade management
Executes upgrades across all spokes with parallel processing and retry capability
"""

import argparse
import json
import subprocess
import sys
import time
import uuid
from datetime import datetime
from pathlib import Path
from concurrent.futures import ThreadPoolExecutor, as_completed
import io

# Set UTF-8 encoding for stdout/stderr
sys.stdout = io.TextIOWrapper(sys.stdout.buffer, encoding='utf-8')
sys.stderr = io.TextIOWrapper(sys.stderr.buffer, encoding='utf-8')

# Add framework to path for WAI modules
framework_path = Path(__file__).parent.resolve()
sys.path.insert(0, str(framework_path))

try:
    from wai.hub import HubManager
    from wai.utils.registry import load_registry
except ImportError as e:
    print(f"ERROR: Could not import WAI modules: {e}", file=sys.stderr)
    sys.exit(1)


class WAIOrchestrator:
    def __init__(self, verbose=False):
        self.hub_manager = HubManager()
        self.hub_path = self.hub_manager.auto_discover_hub(Path.cwd(), verbose=False)
        # Ensure state file is in framework root (accessible)
        self.state_file = Path(framework_path) / "wai-orchestrate-state.json"
        self.state = self._load_state()
        self.start_time = datetime.now()
        self.verbose = verbose

    def _load_state(self):
        if self.state_file.exists():
            try:
                with open(self.state_file, 'r') as f:
                    return json.load(f)
            except:
                pass
        return {
            "run_id": str(uuid.uuid4()),
            "started_at": datetime.now().isoformat(),
            "completed_at": None,
            "teach_completed": False,
            "projects": {},
        }

    def _save_state(self):
        self.state["completed_at"] = datetime.now().isoformat()
        with open(self.state_file, 'w') as f:
            json.dump(self.state, f, indent=2)

    def discover_spokes(self):
        if not self.hub_path:
            print("ERROR: No hub found.")
            sys.exit(1)
        try:
            registry = load_registry(self.hub_path)
            return registry.get('projects', [])
        except Exception as e:
            print(f"ERROR: Failed to load registry: {e}")
            sys.exit(1)

    def run_teach(self):
        """Run wai teach once to update all spokes"""
        print("Running 'wai teach' to update all spokes with latest context...")
        print("=" * 60)

        # Find WAI script in hub
        wai_script = Path(self.hub_path) / "WAI"
        if not wai_script.exists():
            print(f"⚠️  WAI script not found at {wai_script}, marking teach as complete anyway")
            self.state["teach_completed"] = True
            self._save_state()
            return True

        try:
            # Run bash wai script
            result = subprocess.run(
                ["bash", str(wai_script), "teach", "--non-interactive"],
                cwd=str(self.hub_path),
                capture_output=True,
                text=True,
                timeout=600
            )

            self.state["teach_completed"] = True
            self._save_state()

            if result.returncode == 0:
                print("✅ WAI teach completed successfully")
                return True
            else:
                print(f"⚠️  WAI teach completed with warnings (rc={result.returncode})")
                if self.verbose and result.stderr:
                    print(f"stderr: {result.stderr[:500]}")
                return True
        except subprocess.TimeoutExpired:
            print("⚠️  WAI teach timed out, continuing anyway")
            self.state["teach_completed"] = True
            self._save_state()
            return True
        except Exception as e:
            print(f"⚠️  Error running WAI teach: {e}, continuing anyway")
            self.state["teach_completed"] = True
            self._save_state()
            return True

    def upgrade_project(self, project):
        """Execute upgrade steps on a single project"""
        name = project.get('preferred_name', project.get('name', 'unknown'))
        path = project.get('path', '')

        if not path:
            return {
                "project": name,
                "status": "SKIPPED",
                "error": "No path specified",
                "steps_completed": [],
                "timestamp": datetime.now().isoformat()
            }

        # Resolve path
        full_path = Path(path)
        if not full_path.is_absolute() and self.hub_path:
            full_path = Path(self.hub_path) / path

        # Check if path exists
        try:
            if not full_path.exists():
                return {
                    "project": name,
                    "status": "SKIPPED",
                    "error": f"Path does not exist: {full_path}",
                    "steps_completed": [],
                    "timestamp": datetime.now().isoformat()
                }
        except (PermissionError, OSError) as e:
            return {
                "project": name,
                "status": "SKIPPED",
                "error": f"Cannot access path: {e}",
                "steps_completed": [],
                "timestamp": datetime.now().isoformat()
            }

        # Check if WAI script exists
        wai_script = full_path / "WAI"
        if not wai_script.exists():
            return {
                "project": name,
                "status": "SKIPPED",
                "error": "No WAI script found in project",
                "steps_completed": [],
                "timestamp": datetime.now().isoformat()
            }

        print(f"\n🔄 Upgrading {name}...")

        steps_completed = []
        errors = []

        # Step 1: verify-upgrade
        try:
            result = subprocess.run(
                ["bash", str(wai_script), "verify-upgrade", "--non-interactive"],
                cwd=str(full_path),
                capture_output=True,
                text=True,
                timeout=300
            )
            if result.returncode == 0:
                steps_completed.append("verify-upgrade")
                print(f"  ✓ verify-upgrade")
            else:
                errors.append(f"verify-upgrade failed (rc={result.returncode})")
                print(f"  ⚠ verify-upgrade failed, continuing...")
                if self.verbose:
                    print(f"    {result.stderr[:200]}")
        except subprocess.TimeoutExpired:
            errors.append("verify-upgrade timed out")
            print(f"  ⚠ verify-upgrade timed out, continuing...")
        except Exception as e:
            errors.append(f"verify-upgrade error: {str(e)}")
            print(f"  ⚠ verify-upgrade error, continuing...")

        # Step 2: closeout
        try:
            result = subprocess.run(
                ["bash", str(wai_script), "closeout", "--non-interactive", "--skip-quality-gates"],
                cwd=str(full_path),
                capture_output=True,
                text=True,
                timeout=300
            )
            if result.returncode == 0:
                steps_completed.append("closeout")
                print(f"  ✓ closeout")
            else:
                errors.append(f"closeout failed (rc={result.returncode})")
                print(f"  ⚠ closeout failed, continuing...")
                if self.verbose:
                    print(f"    {result.stderr[:200]}")
        except subprocess.TimeoutExpired:
            errors.append("closeout timed out")
            print(f"  ⚠ closeout timed out, continuing...")
        except Exception as e:
            errors.append(f"closeout error: {str(e)}")
            print(f"  ⚠ closeout error, continuing...")

        # Step 3: shipit
        try:
            result = subprocess.run(
                ["bash", str(wai_script), "shipit", "--non-interactive", "--no-push"],
                cwd=str(full_path),
                capture_output=True,
                text=True,
                timeout=300
            )
            if result.returncode == 0:
                steps_completed.append("shipit")
                print(f"  ✓ shipit")
            else:
                errors.append(f"shipit failed (rc={result.returncode})")
                print(f"  ⚠ shipit failed, continuing...")
                if self.verbose:
                    print(f"    {result.stderr[:200]}")
        except subprocess.TimeoutExpired:
            errors.append("shipit timed out")
            print(f"  ⚠ shipit timed out, continuing...")
        except Exception as e:
            errors.append(f"shipit error: {str(e)}")
            print(f"  ⚠ shipit error, continuing...")

        # Step 4: git add WAI-Spoke/
        try:
            result = subprocess.run(
                ["git", "add", "WAI-Spoke/"],
                cwd=str(full_path),
                capture_output=True,
                text=True,
                timeout=30
            )
            if result.returncode == 0:
                steps_completed.append("git-add")
                print(f"  ✓ git add")
            else:
                errors.append(f"git add failed (rc={result.returncode})")
                print(f"  ⚠ git add failed, continuing...")
        except Exception as e:
            errors.append(f"git add error: {str(e)}")
            print(f"  ⚠ git add error, continuing...")

        # Step 5: git commit
        try:
            result = subprocess.run(
                ["git", "commit", "-m", "chore: Wheelwright context upgrade via orchestrator"],
                cwd=str(full_path),
                capture_output=True,
                text=True,
                timeout=30
            )
            if result.returncode == 0:
                steps_completed.append("git-commit")
                print(f"  ✓ git commit")
            else:
                # Check if it's just "nothing to commit"
                if "nothing to commit" in result.stdout or "nothing to commit" in result.stderr:
                    steps_completed.append("git-commit (nothing to commit)")
                    print(f"  ℹ nothing to commit")
                else:
                    errors.append(f"git commit failed (rc={result.returncode})")
                    print(f"  ⚠ git commit failed, continuing...")
        except Exception as e:
            errors.append(f"git commit error: {str(e)}")
            print(f"  ⚠ git commit error, continuing...")

        # Step 6: git push
        try:
            result = subprocess.run(
                ["git", "push", "origin", "HEAD"],
                cwd=str(full_path),
                capture_output=True,
                text=True,
                timeout=60
            )
            if result.returncode == 0:
                steps_completed.append("git-push")
                print(f"  ✓ git push")
            else:
                errors.append(f"git push failed (rc={result.returncode})")
                print(f"  ⚠ git push failed (mark as completed anyway)")
        except Exception as e:
            errors.append(f"git push error: {str(e)}")
            print(f"  ⚠ git push error (mark as completed anyway)")

        # Determine overall status
        if len(steps_completed) >= 3:  # At least verify, closeout, shipit
            status = "SUCCESS"
            print(f"  ✅ {name} upgraded successfully")
        elif len(steps_completed) > 0:
            status = "PARTIAL"
            print(f"  ⚠️  {name} partially upgraded")
        else:
            status = "FAILED"
            print(f"  ❌ {name} upgrade failed")

        return {
            "project": name,
            "path": str(full_path),
            "status": status,
            "steps_completed": steps_completed,
            "errors": errors if errors else None,
            "timestamp": datetime.now().isoformat()
        }

    def upgrade_all_parallel(self, projects, max_workers=4):
        """Upgrade all projects in parallel"""
        print(f"\n{'=' * 60}")
        print(f"AUTOMATED UPGRADE - {len(projects)} projects with {max_workers} workers")
        print(f"{'=' * 60}")

        results = []
        with ThreadPoolExecutor(max_workers=max_workers) as executor:
            futures = {executor.submit(self.upgrade_project, p): p for p in projects}

            for future in as_completed(futures):
                project = futures[future]
                try:
                    result = future.result()
                    results.append(result)

                    # Update state
                    project_name = result['project']
                    self.state['projects'][project_name] = {
                        "status": result['status'],
                        "steps_completed": result['steps_completed'],
                        "errors": result.get('errors'),
                        "timestamp": result['timestamp'],
                        "path": result.get('path')
                    }
                    self._save_state()

                except Exception as e:
                    project_name = project.get('preferred_name', project.get('name', 'unknown'))
                    print(f"  ❌ {project_name} - Exception: {e}")
                    results.append({
                        "project": project_name,
                        "status": "EXCEPTION",
                        "error": str(e),
                        "steps_completed": [],
                        "timestamp": datetime.now().isoformat()
                    })

        return results

    def print_upgrade_summary(self, results):
        """Print summary of upgrade results"""
        print(f"\n{'=' * 60}")
        print("UPGRADE SUMMARY")
        print(f"{'=' * 60}")

        success = [r for r in results if r['status'] == 'SUCCESS']
        partial = [r for r in results if r['status'] == 'PARTIAL']
        failed = [r for r in results if r['status'] in ['FAILED', 'EXCEPTION']]
        skipped = [r for r in results if r['status'] == 'SKIPPED']

        print(f"✅ SUCCESS: {len(success)}")
        for r in success:
            print(f"   • {r['project']}")

        if partial:
            print(f"\n⚠️  PARTIAL: {len(partial)}")
            for r in partial:
                print(f"   • {r['project']} - Steps: {', '.join(r['steps_completed'])}")

        if failed:
            print(f"\n❌ FAILED: {len(failed)}")
            for r in failed:
                print(f"   • {r['project']}")
                if r.get('errors'):
                    for err in r['errors'][:2]:  # Show first 2 errors
                        print(f"     - {err}")

        if skipped:
            print(f"\nℹ️  SKIPPED: {len(skipped)}")
            for r in skipped:
                print(f"   • {r['project']} - {r.get('error', 'No reason')}")

        print(f"\nTotal: {len(results)} projects")
        print(f"State saved to: {self.state_file}")

        # Print retry instructions for failures
        if failed or partial:
            print(f"\n{'=' * 60}")
            print("RETRY FAILED/PARTIAL PROJECTS")
            print(f"{'=' * 60}")
            for r in (failed + partial):
                if r.get('path'):
                    print(f"\ncd {r['path']}")
                    print(f"{framework_path}/wai-orchestrate retry --project-path .")

    def retry_project(self, project_path):
        """Retry upgrade for a single project"""
        full_path = Path(project_path).resolve()

        if not full_path.exists():
            print(f"ERROR: Path does not exist: {full_path}")
            sys.exit(1)

        # Get project name from WAI-State.json if available
        try:
            state_file = full_path / "WAI-Spoke" / "WAI-State.json"
            if state_file.exists():
                with open(state_file) as f:
                    state = json.load(f)
                    name = state.get('project', {}).get('name', full_path.name)
            else:
                name = full_path.name
        except:
            name = full_path.name

        # Create a mock project dict
        project = {
            'name': name,
            'preferred_name': name,
            'path': str(full_path)
        }

        print(f"Retrying upgrade for: {name}")
        result = self.upgrade_project(project)

        # Update state
        self.state['projects'][name] = {
            "status": result['status'],
            "steps_completed": result['steps_completed'],
            "errors": result.get('errors'),
            "timestamp": result['timestamp'],
            "path": str(full_path)
        }
        self._save_state()

        # Print result
        print(f"\n{'=' * 60}")
        print("RETRY RESULT")
        print(f"{'=' * 60}")
        print(f"Project: {name}")
        print(f"Status: {result['status']}")
        print(f"Steps completed: {', '.join(result['steps_completed'])}")
        if result.get('errors'):
            print(f"Errors: {', '.join(result['errors'])}")

        return result['status'] in ['SUCCESS', 'PARTIAL']


def main():
    parser = argparse.ArgumentParser(description="WAI Orchestrator - Automated upgrades")
    parser.add_argument("command", choices=["teach", "list", "upgrade", "retry"],
                       help="Command to execute")
    parser.add_argument("--all", action="store_true", help="Process all spoke projects")
    parser.add_argument("--projects", type=str, help="Comma-separated list of project names")
    parser.add_argument("--parallel", type=int, default=4, help="Number of parallel workers (default: 4)")
    parser.add_argument("--project-path", type=str, help="Path to project for retry command")
    parser.add_argument("--dry-run", action="store_true", help="Show what would be done")
    parser.add_argument("-v", "--verbose", action="store_true", help="Verbose output")

    args = parser.parse_args()

    orchestrator = WAIOrchestrator(verbose=args.verbose)

    if args.command == "teach":
        # Run teach once
        success = orchestrator.run_teach()
        sys.exit(0 if success else 1)

    elif args.command == "list":
        # List all projects
        projects = orchestrator.discover_spokes()
        print(f"Available projects ({len(projects)}):")
        for p in projects:
            name = p.get('preferred_name', p.get('name', 'unknown'))
            status = orchestrator.state.get('projects', {}).get(name, {}).get('status', 'not started')
            print(f"  • {name} [{status}]")
        sys.exit(0)

    elif args.command == "retry":
        # Retry a single project
        if not args.project_path:
            print("ERROR: --project-path required for retry command")
            sys.exit(1)

        success = orchestrator.retry_project(args.project_path)
        sys.exit(0 if success else 1)

    elif args.command == "upgrade":
        # First ensure teach has run
        if not orchestrator.state.get("teach_completed"):
            print("⚠️  Running 'wai teach' first to sync all spokes...\n")
            teach_success = orchestrator.run_teach()
            if not teach_success:
                print("WARNING: WAI teach had issues, but continuing...\n")

        # Get projects to upgrade
        if args.all:
            projects = orchestrator.discover_spokes()
        elif args.projects:
            project_names = args.projects.split(',')
            all_projects = orchestrator.discover_spokes()
            projects = [p for p in all_projects if p.get('name', '') in project_names]
        else:
            print("ERROR: Must specify --all or --projects")
            sys.exit(1)

        if not projects:
            print("No projects found.")
            sys.exit(1)

        if args.dry_run:
            print(f"DRY RUN - Would upgrade {len(projects)} project(s):")
            for p in projects:
                name = p.get('preferred_name', p.get('name', 'unknown'))
                print(f"  • {name}")
            sys.exit(0)

        # Execute automated upgrade
        results = orchestrator.upgrade_all_parallel(projects, max_workers=args.parallel)
        orchestrator.print_upgrade_summary(results)
        orchestrator._save_state()

        # Exit with error if any failures
        failures = [r for r in results if r['status'] in ['FAILED', 'EXCEPTION']]
        sys.exit(1 if failures else 0)


if __name__ == "__main__":
    main()
