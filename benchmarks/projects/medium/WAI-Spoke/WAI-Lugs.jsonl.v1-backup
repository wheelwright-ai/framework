{"i":"auth-jwt-001","t":"JWT Authentication Required","ty":"constraint","s":"o","description":"All protected routes must use JWT token authentication, not session-based auth"}
{"i":"auth-public-001","t":"Public Routes Must Stay Public","ty":"constraint","s":"o","description":"Routes /health, /status, /metrics, /auth/register, /auth/login must remain publicly accessible"}
{"i":"auth-bearer-001","t":"Bearer Token Format","ty":"spec","s":"o","description":"JWT tokens must be passed in Authorization header as 'Bearer <token>'"}
{"i":"user-role-001","t":"User Role System","ty":"feature","s":"o","description":"Users have roles: admin, customer, guest with different permissions"}
{"i":"product-public-001","t":"Product Listing Public","ty":"spec","s":"o","description":"GET /products and GET /products/{id} must be public for browsing"}
{"i":"order-auth-001","t":"Orders Require Authentication","ty":"constraint","s":"o","description":"All order endpoints require authenticated user"}
{"i":"payment-auth-001","t":"Payments Require Authentication","ty":"constraint","s":"o","description":"Payment processing requires authenticated user"}
{"i":"rate-limit-001","t":"Rate Limiting Preserve Auth","ty":"constraint","s":"o","description":"Rate limiting must not interfere with JWT authentication"}
{"i":"cache-ttl-001","t":"Cache TTL Configuration","ty":"spec","s":"o","description":"Cache entries have 300s default TTL, configurable per endpoint"}
{"i":"password-hash-001","t":"Password Hashing with PBKDF2","ty":"spec","s":"o","description":"Passwords hashed using PBKDF2 with 100000 iterations"}
{"i":"validation-email-001","t":"Email Validation Required","ty":"constraint","s":"o","description":"All email inputs must be validated with regex pattern"}
{"i":"logging-structured-001","t":"Structured JSON Logging","ty":"spec","s":"o","description":"All logs output as structured JSON with timestamp, level, message"}
{"i":"error-handling-001","t":"Global Error Handler","ty":"feature","s":"o","description":"Middleware catches all exceptions and returns consistent error format"}
{"i":"order-states-001","t":"Order State Machine","ty":"spec","s":"o","description":"Orders progress: pending → processing → shipped → delivered"}
{"i":"payment-methods-001","t":"Payment Methods Supported","ty":"spec","s":"o","description":"Support credit_card, debit_card, paypal payment methods"}
{"i":"review-rating-001","t":"Review Rating Range","ty":"constraint","s":"o","description":"Product reviews must have rating 1-5"}
{"i":"category-hierarchy-001","t":"Category Hierarchy","ty":"spec","s":"o","description":"Categories support parent-child relationships for organization"}
{"i":"notification-prefs-001","t":"User Notification Preferences","ty":"feature","s":"o","description":"Users can configure email, sms, push notification preferences"}
{"i":"response-format-001","t":"Consistent API Response Format","ty":"spec","s":"o","description":"All responses follow {success, data, error, timestamp} structure"}
{"i":"token-expiry-001","t":"JWT Token Expiration","ty":"spec","s":"o","description":"JWT tokens expire after 24 hours, require refresh"}
