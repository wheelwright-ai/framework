class WheelwrightHubManager:
    """Manages Wheelwright Hub creation and configuration"""

    def __init__(self, framework_path: Path):
        self.framework_path = framework_path
        self.templates_dir = framework_path / 'templates' / 'hub'

    def create_hub(self, hub_path: Path, interactive: bool = True) -> bool:
        """Create a new Wheelwright hub at the specified location"""
        hub_path = hub_path.expanduser().resolve()

        print(f"\n    Creating Wheelwright Hub at: {hub_path}\n")

        # Create hub directory
        hub_path.mkdir(parents=True, exist_ok=True)

        # Create .wwai directory (hub is also a wheel tracking itself)
        wwai_dir = hub_path / '.wwai'
        wwai_dir.mkdir(exist_ok=True)

        # Create .wwai-registry directory
        registry_dir = hub_path / '.wwai-registry'
        registry_dir.mkdir(exist_ok=True)
        (registry_dir / 'wheels').mkdir(exist_ok=True)

        # Gather user info if interactive
        user_info = {}
        if interactive:
            user_info = self._gather_user_info()

        # Create hub-profile.json
        self._create_hub_profile(hub_path, user_info)

        # Create wheel-projects.json
        self._create_wheel_registry(registry_dir)

        # Create hub's own state (it's a wheel tracking itself)
        self._create_hub_state(wwai_dir, hub_path)

        # Create learnings directory
        learnings_dir = hub_path / 'learnings'
        learnings_dir.mkdir(exist_ok=True)

        print(f"\n    Hub created successfully at: {hub_path}")
        print(f"\n    Structure created:")
        print(f"   {hub_path}/")
        print(f"       .wwai/                  # Hub's own state")
        print(f"       .wwai-registry/         # Project registry")
        print(f"           wheels/             # Individual wheel tracking")
        print(f"           wheel-projects.json")
        print(f"       hub-profile.json        # Your preferences")
        print(f"       learnings/              # Cross-project patterns")

        # Discover existing projects
        if interactive:
            self._discover_existing_projects(hub_path, registry_dir)

        print(f"\n    Next steps:")
        print(f"   1. Run 'wwai hub status' to see connected projects")
        print(f"   2. Run 'wwai init <path>' to add more projects")

        return True

    def _discover_existing_projects(self, hub_path: Path, registry_dir: Path):
        """Interactively discover and intake existing projects"""
        print(f"\n    Project Discovery")
        print(f"=" * 50)

        discover = input("\nDo you have existing projects to discover? [Y/n]: ").strip().lower()
        if discover == 'n':
            print("   Skipping project discovery.")
            return

        # Get scan locations
        scan_paths = []
        print("\nEnter directories to scan for projects (one per line).")
        print("Common locations: ~/projects, ~/code, ~/work")
        print("Press Enter with empty line when done.\n")

        while True:
            path_input = input("   Scan path: ").strip()
            if not path_input:
                break
            scan_path = Path(path_input).expanduser()
            if scan_path.exists() and scan_path.is_dir():
                scan_paths.append(scan_path)
                print(f"       Added: {scan_path}")
            else:
                print(f"       Path not found: {scan_path}")

        if not scan_paths:
            # Default to common locations
            default_paths = [Path.home() / 'projects', Path.home() / 'code']
            for dp in default_paths:
                if dp.exists():
                    scan_paths.append(dp)
            if scan_paths:
                print(f"\n   Using default paths: {', '.join(str(p) for p in scan_paths)}")

        if not scan_paths:
            print("   No valid paths to scan.")
            return

        # Load registry to get known projects
        registry_path = registry_dir / 'wheel-projects.json'
        known_paths = set()
        if registry_path.exists():
            try:
                registry = json.loads(registry_path.read_text())
                known_paths = {p.get('path') for p in registry.get('projects', []) if p.get('path')}
                if known_paths:
                    print(f"   (Skipping {len(known_paths)} already registered projects)")
            except:
                pass

        # Scan for projects
        print(f"\n    Scanning for projects...")
        discovered = self._scan_for_projects(scan_paths, known_paths)

        if not discovered:
            print("   No projects found.")
            return

        print(f"\n    Found {len(discovered)} projects")
        for proj in discovered:
            status = "    Wheelwright" if proj.get('wwai_enabled') else "   "
            print(f"   {status} {proj['name']}")

    def _scan_for_projects(self, scan_paths: list, known_paths: set = None) -> list:
        """Scan directories for projects"""
        discovered = []
        seen_paths = set()
        known_paths = known_paths or set()

        for scan_path in scan_paths:
            try:
                for item in scan_path.iterdir():
                    if not item.is_dir():
                        continue
                    if item.name.startswith('.'):
                        continue
                    if str(item.resolve()) in seen_paths:
                        continue
                    if str(item.resolve()) in known_paths:
                        continue

                    # Check if it's a project
                    is_git = (item / '.git').exists()
                    is_wwai = (item / '.wwai').exists()
                    is_scf = (item / '.scf').exists()  # Legacy SCF support
                    has_package = (item / 'package.json').exists()
                    has_pyproject = (item / 'pyproject.toml').exists() or (item / 'setup.py').exists()
                    has_cargo = (item / 'Cargo.toml').exists()

                    if is_git or is_wwai or is_scf or has_package or has_pyproject or has_cargo:
                        proj_info = {
                            'name': item.name,
                            'path': str(item.resolve()),
                            'wwai_enabled': is_wwai,
                            'scf_legacy': is_scf and not is_wwai,
                            'has_git': is_git,
                            'description': None,
                            'project_type': None
                        }

                        discovered.append(proj_info)
                        seen_paths.add(str(item.resolve()))

            except PermissionError:
                continue

        return sorted(discovered, key=lambda x: (not x['wwai_enabled'], x['name'].lower()))

    def _gather_user_info(self) -> dict:
        """Interactive user info gathering"""
        print("    Let's personalize your hub:\n")

        name = input("   What name should AI partners call you? ").strip()

        print("\n   What's your primary development focus?")
        print("   (e.g., 'Full-stack web, Python automation')")
        focus = input("   > ").strip()

        print("\n   How do you prefer AI collaboration?")
        print("   [1] Autonomous - Take initiative, check in on big decisions")
        print("   [2] Collaborative - Discuss approach before implementing")
        print("   [3] Supervised - Always ask before acting")

        while True:
            style_choice = input("   > ").strip()
            if style_choice == "1":
                style = "autonomous"
                break
            elif style_choice == "2":
                style = "collaborative"
                break
            elif style_choice == "3":
                style = "supervised"
                break
            else:
                print("   Please enter 1, 2, or 3")

        return {
            'name': name,
            'focus': focus,
            'style': style
        }

    def _create_hub_profile(self, hub_path: Path, user_info: dict):
        """Create hub-profile.json with user info"""
        profile_template = self.templates_dir / 'hub-profile.json'

        if profile_template.exists():
            with open(profile_template) as f:
                profile = json.load(f)
        else:
            profile = {
                "user": {"name": None},
                "work_style": {"description": None},
                "hub_config": {}
            }

        # Fill in user info
        profile['user']['name'] = user_info.get('name', 'Developer')
        profile['work_style']['description'] = user_info.get('focus', '')
        profile['work_style']['ai_collaboration_style'] = user_info.get('style', 'collaborative')
        profile['hub_config']['created_at'] = datetime.now(timezone.utc).isoformat()
        profile['hub_config']['hub_path'] = str(hub_path)
        profile['hub_config']['framework_path'] = str(self.framework_path)

        profile_path = hub_path / 'hub-profile.json'
        with open(profile_path, 'w') as f:
            json.dump(profile, f, indent=2)

        print(f"       Created hub-profile.json")

    def _create_wheel_registry(self, registry_dir: Path):
        """Create wheel-projects.json registry"""
        registry_template = self.templates_dir / 'wheel-projects.json'

        if registry_template.exists():
            shutil.copy2(registry_template, registry_dir / 'wheel-projects.json')
        else:
            registry = {
                "version": "1.0",
                "projects": [],
                "last_scan": None
            }
            with open(registry_dir / 'wheel-projects.json', 'w') as f:
                json.dump(registry, f, indent=2)

        print(f"       Created wheel registry")

    def _create_hub_state(self, wwai_dir: Path, hub_path: Path):
        """Create hub's own state (hub tracks itself as a wheel)"""
        state = {
            "wheelwright": {
                "version": "1.0.0",
                "structure_version": "v1",
                "description": "Wheelwright Hub - Your personal learning center",
                "is_hub": True,
                "hub_path": str(hub_path)
            },
            "_project_foundation": {
                "completed": True,
                "completed_at": datetime.now(timezone.utc).isoformat(),
                "identity": {
                    "type": "hub",
                    "name": "Wheelwright Hub",
                    "one_liner": "Central hub for cross-project learnings",
                    "success_looks_like": "All projects connected, learnings flowing"
                },
                "boundaries": {
                    "in_scope": ["User preferences", "Project registry", "Cross-project learnings"],
                    "out_of_scope": ["Individual project code", "Framework development"]
                }
            },
            "_session_state": {
                "last_modified_by": "wwai hub create",
                "last_modified_at": datetime.now(timezone.utc).isoformat(),
                "session_count": 1
            },
            "wheel": {
                "name": "Wheelwright Hub",
                "type": "hub",
                "created": datetime.now(timezone.utc).isoformat()
            }
        }

        with open(wwai_dir / 'WWAI-State.json', 'w') as f:
            json.dump(state, f, indent=2)

        print(f"       Created hub state")

    @staticmethod
    def find_hub() -> Optional[Path]:
        """Find existing hub location"""
        import os

        # Check environment variable first
        env_hub = os.environ.get('WHEELWRIGHT_HUB_PATH')
        if env_hub:
            env_path = Path(env_hub).expanduser()
            if env_path.exists():
                return env_path

        # Check common locations
        common_paths = [
            Path.home() / 'wheelwright-hub',
            Path.home() / '.wheelwright-hub',
            Path.home() / 'projects' / 'wheelwright-hub',
            # Legacy SCF locations
            Path.home() / 'scf-hub',
            Path.home() / '.scf-hub',
        ]

        for path in common_paths:
            if (path / 'hub-profile.json').exists():
                return path

        return None


class WheelwrightCLI:
    """Main CLI class for Wheelwright"""

    def __init__(self):
        self.framework_path = Path(__file__).parent.resolve()
        self.templates_dir = self.framework_path / 'templates'

    def run(self):
        """Main entry point"""
        parser = argparse.ArgumentParser(
            description='Wheelwright Framework - Build AI wheels that roll forward forever',
            formatter_class=argparse.RawDescriptionHelpFormatter,
            epilog='''
Examples:
  wwai init                    Initialize wheel in current directory
  wwai init ~/projects/myapp   Initialize wheel in specified path
  wwai status                  Show wheel status
  wwai hub create              Create a new hub
  wwai hub status              Show hub status
  wwai sync                    Sync wheel with hub
  wwai closeout                Generate closeout for session end
  wwai context                 Output context for LLM paste

"We aren't reinventing the wheel - we're evolving it faster than one person ever could."
            '''
        )

        subparsers = parser.add_subparsers(dest='command', help='Commands')

        # Init command
        init_parser = subparsers.add_parser('init', help='Initialize a new wheel')
        init_parser.add_argument('path', nargs='?', default='.', help='Project path (default: current directory)')
        init_parser.add_argument('--guided', '-g', action='store_true', help='Interactive guided setup')

        # Status command
        status_parser = subparsers.add_parser('status', help='Show wheel status')
        status_parser.add_argument('path', nargs='?', default='.', help='Project path')

        # Hub commands
        hub_parser = subparsers.add_parser('hub', help='Hub management commands')
        hub_subparsers = hub_parser.add_subparsers(dest='hub_command')

        hub_create = hub_subparsers.add_parser('create', help='Create a new hub')
        hub_create.add_argument('path', nargs='?', default=None, help='Hub location')
        hub_create.add_argument('--guided', '-g', action='store_true', help='Interactive guided setup')

        hub_status = hub_subparsers.add_parser('status', help='Show hub status')
        hub_locate = hub_subparsers.add_parser('locate', help='Find hub location')

        # Sync command
        sync_parser = subparsers.add_parser('sync', help='Sync wheel with hub')
        sync_parser.add_argument('--all', action='store_true', help='Sync all wheels')

        # Closeout command
        closeout_parser = subparsers.add_parser('closeout', help='Generate session closeout')

        # Context command
        context_parser = subparsers.add_parser('context', help='Output context for LLM paste')
        context_parser.add_argument('path', nargs='?', default='.', help='Project path')

        # Spoke commands
        spoke_parser = subparsers.add_parser('spoke', help='Spoke management')
        spoke_subparsers = spoke_parser.add_subparsers(dest='spoke_command')

        spoke_list = spoke_subparsers.add_parser('list', help='List available spokes')
        spoke_add = spoke_subparsers.add_parser('add', help='Add a spoke')
        spoke_add.add_argument('name', help='Spoke name')

        # Version command
        version_parser = subparsers.add_parser('version', help='Show version info')

        # Parse args
        args = parser.parse_args()

        if not args.command:
            # No command - show welcome or help
            onboarding = WheelwrightOnboarding()
            onboarding.show_welcome()
            role = onboarding.choose_role()

            if role == "hub":
                self.hub_create(None, guided=True)
            else:
                self.init_wheel('.', guided=True)
            return

        # Route to command handlers
        if args.command == 'init':
            self.init_wheel(args.path, guided=args.guided)
        elif args.command == 'status':
            self.show_status(args.path)
        elif args.command == 'hub':
            if args.hub_command == 'create':
                self.hub_create(args.path, guided=args.guided)
            elif args.hub_command == 'status':
                self.hub_status()
            elif args.hub_command == 'locate':
                self.hub_locate()
            else:
                hub_parser.print_help()
        elif args.command == 'sync':
            self.sync(all_wheels=args.all)
        elif args.command == 'closeout':
            self.closeout()
        elif args.command == 'context':
            self.output_context(args.path)
        elif args.command == 'spoke':
            if args.spoke_command == 'list':
                self.spoke_list()
            elif args.spoke_command == 'add':
                self.spoke_add(args.name)
            else:
                spoke_parser.print_help()
        elif args.command == 'version':
            self.show_version()
        else:
            parser.print_help()

    def init_wheel(self, path: str, guided: bool = False):
        """Initialize a new wheel in the specified directory"""
        project_path = Path(path).expanduser().resolve()

        if not project_path.exists():
            print(f"    Error: Path does not exist: {project_path}")
            return

        wwai_dir = project_path / '.wwai'

        if wwai_dir.exists():
            print(f"    Wheel already exists at: {project_path}")
            print(f"   Run 'wwai status' to see wheel state")
            return

        print(f"\n    Initializing Wheelwright Wheel")
        print(f"   Path: {project_path}\n")

        # Create .wwai directory
        wwai_dir.mkdir(exist_ok=True)

        # Copy template files
        wheel_templates = self.templates_dir / 'wheel'

        # WWAI-State.json
        state_template = wheel_templates / 'WWAI-State.json'
        if state_template.exists():
            with open(state_template) as f:
                state = json.load(f)
        else:
            state = self._create_default_state()

        # Update with project info
        state['wheel']['name'] = project_path.name
        state['wheel']['created'] = datetime.now(timezone.utc).isoformat()
        state['wheel']['last_updated'] = datetime.now(timezone.utc).isoformat()
        state['wheelwright']['framework_path'] = str(self.framework_path)

        # Check for hub
        hub_path = WheelwrightHubManager.find_hub()
        if hub_path:
            state['wheelwright']['hub_path'] = str(hub_path)

        with open(wwai_dir / 'WWAI-State.json', 'w') as f:
            json.dump(state, f, indent=2)

        # WWAI-State.md
        state_md_template = wheel_templates / 'WWAI-State.md'
        if state_md_template.exists():
            content = state_md_template.read_text()
            content = content.replace('[PROJECT_NAME]', project_path.name)
            (wwai_dir / 'WWAI-State.md').write_text(content)
        else:
            self._create_default_state_md(wwai_dir, project_path.name)

        # WWAI-Guide.md
        guide_template = wheel_templates / 'WWAI-Guide.md'
        if guide_template.exists():
            shutil.copy2(guide_template, wwai_dir / 'WWAI-Guide.md')

        # kb-sync.json
        kb_template = wheel_templates / 'kb-sync.json'
        if kb_template.exists():
            shutil.copy2(kb_template, wwai_dir / 'kb-sync.json')
        else:
            kb_sync = {"version": "1.0", "wheel_kb_version": None, "hub_kb_version": None, "last_sync": None}
            with open(wwai_dir / 'kb-sync.json', 'w') as f:
                json.dump(kb_sync, f, indent=2)

        # wheel-signals.jsonl (empty)
        (wwai_dir / 'wheel-signals.jsonl').touch()

        print(f"    Wheel initialized successfully!")
        print(f"\n    Created:")
        print(f"   {wwai_dir}/")
        print(f"       WWAI-State.json      # Machine state")
        print(f"       WWAI-State.md        # Strategic state")
        print(f"       WWAI-Guide.md        # AI instructions")
        print(f"       kb-sync.json         # Hub sync status")
        print(f"       wheel-signals.jsonl  # High-impact learnings")

        if hub_path:
            print(f"\n    Connected to hub: {hub_path}")
        else:
            print(f"\n    No hub found. Run 'wwai hub create' to create one.")

        print(f"\n    Next steps:")
        print(f"   1. Start an AI session and share your .wwai/ context")
        print(f"   2. Complete the project foundation with your AI partner")
        print(f"   3. Use 'Time', 'Rules', 'Closeout' commands during sessions")

