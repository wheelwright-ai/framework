    def spoke_add(self, name: str):
        """Add a spoke to current wheel"""
        project_path = Path('.').resolve()
        wwai_dir = project_path / '.wwai'

        if not wwai_dir.exists():
            print(f"\n    No wheel in current directory")
            return

        # Load state
        state_path = wwai_dir / 'WWAI-State.json'
        with open(state_path) as f:
            state = json.load(f)

        # Check if spoke exists
        available = state.get('spokes', {}).get('available', [])
        active = state.get('spokes', {}).get('active', [])

        if name not in available:
            print(f"\n    Spoke '{name}' not found")
            print(f"   Available: {', '.join(available)}")
            return

        if name in active:
            print(f"\n    Spoke '{name}' already active")
            return

        # Add spoke
        if 'spokes' not in state:
            state['spokes'] = {'active': [], 'available': available}
        state['spokes']['active'].append(name)

        with open(state_path, 'w') as f:
            json.dump(state, f, indent=2)

        print(f"\n    Added spoke: {name}")

