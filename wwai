    def show_status(self, path: str = '.'):
        """Show wheel status"""
        project_path = Path(path).expanduser().resolve()
        wwai_dir = project_path / '.wwai'

        if not wwai_dir.exists():
            # Check for legacy SCF
            scf_dir = project_path / '.scf'
            if scf_dir.exists():
                print(f"\n    Legacy SCF project detected")
                print(f"   Run 'wwai migrate' to convert to Wheelwright")
                return

            print(f"\n    No wheel found at: {project_path}")
            print(f"   Run 'wwai init' to create one")
            return

        # Load state
        state_path = wwai_dir / 'WWAI-State.json'
        if not state_path.exists():
            print(f"    Wheel directory exists but WWAI-State.json missing")
            return

        with open(state_path) as f:
            state = json.load(f)

        # Display status
        wheel = state.get('wheel', {})
        foundation = state.get('_project_foundation', {})
        session = state.get('_session_state', {})
        wwai_meta = state.get('wheelwright', {})

        print(f"\n    Wheelwright Status")
        print(f"=" * 50)

        print(f"\n    Wheel: {wheel.get('name', project_path.name)}")
        if wheel.get('type'):
            print(f"   Type: {wheel['type']}")
        if foundation.get('identity', {}).get('one_liner'):
            print(f"   Description: {foundation['identity']['one_liner']}")

        print(f"\n    Foundation:")
        if foundation.get('completed'):
            print(f"       Complete")
        else:
            print(f"       Incomplete - needs setup")

        print(f"\n    Session State:")
        print(f"   Last modified by: {session.get('last_modified_by', 'Unknown')}")
        print(f"   Sessions: {session.get('session_count', 0)}")

        if wwai_meta.get('hub_path'):
            print(f"\n    Hub: {wwai_meta['hub_path']}")
        else:
            print(f"\n    Hub: Not connected")

        # Check signals
        signals_path = wwai_dir / 'wheel-signals.jsonl'
        if signals_path.exists():
            signal_count = sum(1 for _ in open(signals_path) if _.strip())
            if signal_count > 0:
                print(f"\n    Signals: {signal_count} high-impact learnings recorded")

    def hub_create(self, path: Optional[str], guided: bool = False):
        """Create a new hub"""
        if path:
            hub_path = Path(path).expanduser()
        else:
            # Default location
            hub_path = Path.home() / 'wheelwright-hub'
            print(f"\n   No path specified. Using default: {hub_path}")
            confirm = input("   Continue? [Y/n]: ").strip().lower()
            if confirm == 'n':
                custom = input("   Enter custom path: ").strip()
                if custom:
                    hub_path = Path(custom).expanduser()
                else:
                    print("   Cancelled.")
                    return

        manager = WheelwrightHubManager(self.framework_path)
        manager.create_hub(hub_path, interactive=True)

