# Normalize line endings on commit
* text=auto
*.sh text eol=lf
*.py text eol=lf
*.md text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.json text eol=lf
*.jsonl text eol=lf
*.txt text eol=lf

# Binaries — no normalization
*.png binary
*.jpg binary
*.gif binary
*.ico binary
*.zip binary
*.gz binary
