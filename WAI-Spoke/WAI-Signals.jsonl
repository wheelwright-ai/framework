{"id": "lazy-loading-opt-20260205", "timestamp": "2026-02-05T23:18:58.760668+00:00", "source": "framework", "spoke_id": "7a1d9c5b3e2f", "category": "optimization", "impact": 9, "title": "Context Efficiency Through Lazy-Loading Architecture", "description": "Session hooks should provide pre-computed briefings, not instruct agents to read files redundantly. File loading transparency (bytes/tokens loaded vs available) enables agents to understand efficiency gains and make informed decisions about loading additional context.", "learning": "Redundant file loading at session start wastes 2-4K tokens when briefing already computed. Adding file metrics (4 loaded / 63 total, 27K tokens vs 102K saved) demonstrates efficiency and guides agent behavior. Lazy-loading philosophy: load core files always, load reference/archived files on-demand only.", "implementation_pattern": {"hook_optimization": "Change from 'Load files' to 'Review briefing (pre-computed)'", "briefing_transparency": "Show: N loaded / M total (X%) \u2192 YKB / ZKB (P%) \u2248 Q tokens [Saved: RKB \u2248 S tokens]", "conditional_display": "Only show metrics when data available (no guessing)", "load_policy_categories": ["always", "summary_only", "on_request", "never"]}, "evidence": {"token_savings": "2-4K per session start (immediate), 100K+ potential (full lazy-loading)", "files_analyzed": 63, "lazy_loadable": 59, "percentage_deferred": "94%"}, "applies_to": ["all_spokes", "framework"], "tags": ["lazy-loading", "context-efficiency", "token-optimization", "hooks", "briefing"]}
