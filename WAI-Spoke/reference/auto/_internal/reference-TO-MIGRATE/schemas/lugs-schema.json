{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "title": "WAI Lug",
    "description": "A unit of work (Task, Epic, Bug, etc.) in the Wheelwright AI Framework.",
    "type": "object",
    "required": [
        "id",
        "title",
        "type",
        "status",
        "priority",
        "created_at"
    ],
    "properties": {
        "id": {
            "type": "string",
            "description": "Unique identifier (SHA-256 hash segment or hierarchical ID)."
        },
        "title": {
            "type": "string",
            "description": "Human-readable summary of the work."
        },
        "type": {
            "type": "string",
            "enum": [
                "epic",
                "feature",
                "task",
                "bug",
                "chore",
                "work",
                "ask"
            ],
            "description": "The category of work."
        },
        "status": {
            "type": "string",
            "enum": [
                "open",
                "in_progress",
                "closed",
                "blocked"
            ],
            "description": "Current state of the Lug."
        },
        "priority": {
            "type": "string",
            "enum": [
                "critical",
                "high",
                "medium",
                "low",
                "0",
                "1",
                "2",
                "3",
                "4"
            ],
            "description": "Urgency of the work."
        },
        "impact": {
            "type": "string",
            "enum": [
                "large",
                "medium",
                "small"
            ],
            "description": "Expected magnitude of the change."
        },
        "value": {
            "type": [
                "integer",
                "null"
            ],
            "minimum": 1,
            "maximum": 10,
            "description": "Estimated ROI score (1-10)."
        },
        "created_at": {
            "type": "string",
            "format": "date-time",
            "description": "ISO 8601 timestamp of creation."
        },
        "updated_at": {
            "type": [
                "string",
                "null"
            ],
            "format": "date-time"
        },
        "closed_at": {
            "type": [
                "string",
                "null"
            ],
            "format": "date-time"
        },
        "session_id": {
            "type": [
                "string",
                "null"
            ],
            "description": "ID of the session where this Lug was created or worked on."
        },
        "deps": {
            "type": "array",
            "items": {
                "type": "string"
            },
            "description": "List of Lug IDs that block this work."
        },
        "blocked_by": {
            "type": "array",
            "items": {
                "type": "string"
            },
            "description": "Inverse of deps; Lugs that claim to block this one (legacy)."
        },
        "policy_tags": {
            "type": "array",
            "items": {
                "type": "string"
            },
            "description": "Tags enforcing specific workflows (e.g., 'security-review')."
        },
        "origin": {
            "type": [
                "string",
                "null"
            ],
            "description": "Source of the request (e.g., 'user_chat', 'github_issue')."
        },
        "resolved_by": {
            "type": [
                "string",
                "null"
            ],
            "description": "Agent or User who completed the work."
        },
        "summary": {
            "type": [
                "string",
                "null"
            ],
            "description": "Closing summary or result description."
        },
        "justification": {
            "type": [
                "string",
                "null"
            ],
            "description": "Reasoning for the work's priority or existence."
        },
        "from_file": {
            "type": [
                "string",
                "null"
            ],
            "description": "If imported, the source file."
        },
        "extras": {
            "type": "object",
            "description": "Flexible key-value store for plugin-specific data."
        }
    }
}