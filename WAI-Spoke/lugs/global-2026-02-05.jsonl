{"i": "617e09f2010a", "t": "policy", "ty": "policy", "title": "Specification Persistence and Protection Protocol", "s": "o", "status": "open", "description": "Agent stewardship protocol for maintaining top-level features: (1) Capture user specifications to Lugs immediately, (2) Flag top-level features with load_always=true and verify_on_closeout=true, (3) Before changes impacting flagged features, ASK and explain tradeoffs, (4) Git history is authoritative record, (5) Features persist until user says otherwise. Impact: Prevents silent degradation of prime directives. Applies to: All AI agents working on this project.", "created_at": "2026-02-05T01:02:55.119501", "updated_at": "2026-02-05T01:02:55.119501", "priority": "session_focus", "impact": 10, "value": 10, "scope": "all_spokes", "load_always": true, "verify_on_closeout": true, "tags": ["framework", "philosophy", "agent-behavior", "stewardship"], "blocks": [], "blocked_by": []}
